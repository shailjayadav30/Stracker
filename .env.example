# Copy to .env and fill in real values

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shinro

# better-auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional cheaper model for subject detection (defaults to GEMINI_MODEL)
# GEMINI_MODEL_DETECT=gemini-3.5-flash-lite

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Trust exp:// origins (Expo Go during development)
ALLOW_EXPO_GO=false

# Upstash Redis (shared upload rate limit across instances)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Permanent PDF storage. Without any, PDFs are kept in Gemini for ~48h only and generating
# more subjects later needs a re-upload. New PDFs go to S3 when configured, otherwise to
# Cloudinary; keep CLOUDINARY_URL set after switching so PDFs stored there stay readable.
#
# Cloudinary (Dashboard -> API Keys -> "API environment variable")
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
#
# Any S3-compatible bucket (set all five or none)
# Supabase Storage: https://<project-ref>.storage.supabase.co/storage/v1/s3, region = project region
# Backblaze B2:     https://s3.<region>.backblazeb2.com, region e.g. us-west-004
# AWS S3:           https://s3.<region>.amazonaws.com
# Cloudflare R2:    https://<account-id>.r2.cloudflarestorage.com, region = auto
# S3_ENDPOINT=https://your-project-ref.storage.supabase.co/storage/v1/s3
# S3_REGION=ap-south-1
# S3_ACCESS_KEY_ID=your-access-key-id
# S3_SECRET_ACCESS_KEY=your-secret-access-key
# S3_BUCKET=syllabus-pdfs
# Path-style URLs (default true; Supabase requires them)
# S3_FORCE_PATH_STYLE=true

# Optional: Google sign-in (not enabled yet)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
