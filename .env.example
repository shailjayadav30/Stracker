# Copy to .env and fill in real values

NODE_ENV=development
PORT=3000

# Postgres connection string
DATABASE_URL=postgresql://user:password@localhost:5432/shinro

# better-auth
BETTER_AUTH_SECRET=replace-with-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000

# Gemini
GEMINI_API_KEY=your-gemini-api-key
# GEMINI_MODEL=gemini-3.5-flash-lite
# Optional cheaper model for subject detection (defaults to GEMINI_MODEL)
# GEMINI_MODEL_DETECT=gemini-3.5-flash-lite

# Comma-separated list of allowed CORS origins
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Trust exp:// origins (Expo Go during development)
ALLOW_EXPO_GO=false

# Upstash Redis (shared upload rate limit across instances)
UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token

# Optional: Google sign-in (not enabled yet)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
