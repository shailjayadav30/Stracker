// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String           @id @default(uuid())
  name          String
  email         String           @unique
  image         String?
  emailVerified Boolean          @default(false)
  roadmaps      Roadmap[]
  sessions      Session[]
  accounts      Account[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  studySessions StudySession[]
  uploads       SyllabusUpload[]
  spaces        Space[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  issuer                String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Roadmap {
  id            String          @id @default(uuid())
  name          String
  userId        String
  isFollowing   Boolean         @default(false)
  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  units         Unit[]
  studySessions StudySession[]
  // Set for roadmaps generated through analyze -> generate
  documentType  DocumentType?
  examOrBoard   String?
  subjectGroup  String? // "Semester 3", "Prelims", ... from the analysis
  // Every roadmap lives in one of the user's spaces; deleting the space deletes it
  spaceId       String
  space         Space           @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  promptVersion String?
  // The PDF this roadmap was generated from (to show it in the app)
  uploadId      String?
  upload        SyllabusUpload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([spaceId])
  @@index([uploadId])
}

model Unit {
  id          String   @id @default(uuid())
  name        String
  // Order within the roadmap (syllabus order); createdAt can tie for rows created together
  position    Int      @default(0)
  sourceLabel String? // what the document called it: "Unit", "Chapter", "Module", ...
  roadmapId   String
  roadmap     Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  topics      Topic[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([roadmapId, position])
}

model Topic {
  id        String     @id @default(uuid())
  name      String
  position  Int        @default(0)
  unitId    String
  completed Boolean    @default(false)
  unit      Unit       @relation(fields: [unitId], references: [id], onDelete: Cascade)
  subTopics SubTopic[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  @@index([unitId, position])
}

model SubTopic {
  id        String   @id @default(uuid())
  name      String
  position  Int      @default(0)
  topicId   String
  topic     Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([topicId, position])
}

// A timed study session on one roadmap (stopwatch). A user has at most one open
// (ACTIVE or PAUSED) session; it counts toward stats and streaks once COMPLETED.
// Discarded sessions are deleted.
model StudySession {
  id            String             @id @default(uuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  // Kept (null) when the roadmap is deleted, so past days still count toward streaks
  roadmapId     String?
  roadmap       Roadmap?           @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  roadmapName   String // copied at start, shown in history even after the roadmap is gone
  status        StudySessionStatus
  // Seconds studied before the current running stretch; while ACTIVE add now - resumedAt
  activeSeconds Int                @default(0)
  resumedAt     DateTime? // set while ACTIVE (running), null while paused or ended
  startedAt     DateTime           @default(now())
  endedAt       DateTime?
  // The user's local calendar day the session ended on ("2026-10-12"), for daily stats and streaks
  endedOnDay    String?
  items         StudySessionItem[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, status])
  @@index([userId, endedOnDay])
  @@index([roadmapId])
}

enum StudySessionStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

enum StudyItemKind {
  TOPIC
  SUBTOPIC
}

// A topic or subtopic ticked off while a session was open. No foreign key to the
// topic, so history keeps counting it even if the topic is deleted later.
model StudySessionItem {
  id          String        @id @default(uuid())
  sessionId   String
  session     StudySession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  kind        StudyItemKind
  itemId      String
  name        String
  completedAt DateTime      @default(now())

  @@unique([sessionId, kind, itemId])
}

enum DocumentType {
  SCHOOL
  COLLEGE
  COMPETITIVE_EXAM
  PROFESSIONAL
  OTHER
}

// One uploaded PDF, per user. The PDF itself lives in the Gemini Files API until expiresAt.
model SyllabusUpload {
  id                String            @id @default(uuid())
  userId            String
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pdfHash           String
  pageCount         Int
  fileName          String?
  // Permanent copy in S3-compatible object storage, shared by uploads with the same pdfHash
  storageKey        String?
  // Temporary copy in the Gemini Files API; re-uploaded from storage after expiresAt
  geminiFileName    String? // "files/abc123"; null once unusable
  geminiFileUri     String?
  expiresAt         DateTime // when the Gemini copy expires
  analysisId        String?
  analysis          SyllabusAnalysis? @relation(fields: [analysisId], references: [id], onDelete: SetNull)
  analysisFromCache Boolean           @default(false)
  // The space it was uploaded into; its subjects can be turned into roadmaps there
  spaceId           String?
  space             Space?            @relation(fields: [spaceId], references: [id], onDelete: SetNull)
  roadmaps          Roadmap[]
  createdAt         DateTime          @default(now())

  @@index([userId, createdAt])
  @@index([expiresAt])
  @@index([spaceId])
}

// Shared cache of pass-1 (subject detection) results, keyed by PDF content
model SyllabusAnalysis {
  id            String           @id @default(uuid())
  pdfHash       String
  promptVersion String
  model         String
  isSyllabus    Boolean
  documentType  DocumentType?
  examOrBoard   String?
  language      String?
  subjectsJson  Json // [{ name, group, startPage, endPage }]
  uploads       SyllabusUpload[]
  createdAt     DateTime         @default(now())

  @@unique([pdfHash, promptVersion, model])
}

// A user-named collection of roadmaps, e.g. "UPSC 2027". Syllabus PDFs are uploaded into a
// space and the subjects the user picks become roadmaps in it.
model Space {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  roadmaps  Roadmap[]
  uploads   SyllabusUpload[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([userId])
}
